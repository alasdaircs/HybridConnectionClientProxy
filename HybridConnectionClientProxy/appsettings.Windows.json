{
	"Serilog": {
		"WriteTo": {
			"Debug": {
				"Name": "Debug"
			},
			"File": {
				"Name": "File",
				"Args": {
					"path": "%TEMP%\\HybridConnectionClientProxy-.log",
					"rollingInterval": "Day",
					"rollOnFileSizeLimit": true,
					"fileSizeLimitBytes": 1048576,
					"retainedFileCountLimit": 10
				}
			}
		}
	}
}
